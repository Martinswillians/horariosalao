rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Acesso de profissionais ----
    // O dono cadastra o e-mail do profissional em saloes/{uid}/acessos/{email}. O profissional só entra
    // com e-mail VERIFICADO igual ao cadastrado.
    function emailKey() { return request.auth.token.email.lower(); }
    function isProf(uid) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/saloes/$(uid)/acessos/$(emailKey()));
    }
    function profIdOf(uid) {
      return get(/databases/$(database)/documents/saloes/$(uid)/acessos/$(emailKey())).data.profId;
    }

    // Salão: vitrine pública, só o dono edita
    match /saloes/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /agendamentos/{id} {
        // qualquer pessoa agenda; se informar cuid, tem que ser o próprio usuário logado;
        // ninguém cria um agendamento já "pago" nem com comprovante
        allow create: if request.resource.data.nome is string
                      && request.resource.data.nome.size() < 100
                      && (!('cuid' in request.resource.data)
                          || request.resource.data.cuid == ''
                          || (request.auth != null && request.resource.data.cuid == request.auth.uid))
                      && (!('pstatus' in request.resource.data) || request.resource.data.pstatus == 'pendente')
                      && !('comp' in request.resource.data)
                      && (!('foto' in request.resource.data) || request.resource.data.foto.size() < 60000);
        // dono, o próprio cliente e o profissional responsável leem
        allow read: if request.auth != null
                      && (request.auth.uid == uid
                          || resource.data.get('cuid', '') == request.auth.uid
                          || (isProf(uid) && resource.data.prof == profIdOf(uid)));
        // dono e o próprio cliente cancelam
        allow delete: if request.auth != null
                      && (request.auth.uid == uid || resource.data.get('cuid', '') == request.auth.uid);
        // dono edita tudo
        allow update: if request.auth != null && request.auth.uid == uid;
        // profissional só marca concluído/faltou nos próprios atendimentos
        allow update: if isProf(uid)
                      && resource.data.prof == profIdOf(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        // quem agendou pode anexar o comprovante PIX (só comp e pstatus='aguardando'), se ainda não estiver pago
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comp', 'pstatus'])
                      && request.resource.data.pstatus == 'aguardando'
                      && resource.data.get('pstatus', 'pendente') != 'pago'
                      && request.resource.data.comp is string
                      && request.resource.data.comp.size() < 400000;
      }

      // Observações privadas do salão sobre cada cliente (só o dono)
      match /notas/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Agenda de cada profissional (horário próprio e folgas): público para o cliente ver a disponibilidade;
      // grava o dono ou o próprio profissional
      match /agendas/{pid} {
        allow read: if true;
        allow write: if request.auth != null
                      && (request.auth.uid == uid || (isProf(uid) && profIdOf(uid) == pid));
      }

      // E-mails autorizados a entrar como profissional: o dono gerencia; cada profissional lê só o próprio
      match /acessos/{em} {
        allow read: if request.auth != null
                      && (request.auth.uid == uid
                          || (request.auth.token.email_verified == true && em == request.auth.token.email.lower()));
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Perfil do cliente (nome, telefone, foto) — só o próprio
    match /clientes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Endereço do link de cada salão
    match /slugs/{s} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Horários ocupados (sem dados pessoais)
    match /ocupados/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['uid','prof','data','hora','cuid','m']);
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid || resource.data.get('cuid', '') == request.auth.uid);
    }
  }
}
